{
  "name": "team-todo-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "team-todo-db",
      "database_id": "54190e5f-8add-429d-99fb-2c7da4cd4901"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "REALTIME", "class_name": "RealtimeChannel" }
    ]
  },
  "migrations": [
    { "tag": "v1-realtime", "new_sqlite_classes": ["RealtimeChannel"] }
  ],
  "env": {
    "production": {
      "vars": {
        "ENVIRONMENT": "production"
      }
    }
  },
  "vars": {
    "ENVIRONMENT": "development"
  },
  "observability": {
    "enabled": true
  }
}
